<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="CrackNEET" android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="NEET + JEE Main | PYQ Pattern Practice" android:textSize="16sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/neetButton" android:text="NEET Practice" android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/jeeButton" android:text="JEE Main Practice" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:text="Choose an exam to start practice." android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
