<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F8FC">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_crackneet"
                android:contentDescription="CrackNEET logo" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/title"
                    android:text="CrackNEET"
                    android:textColor="#102A43"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/meta"
                    android:text="NEET + JEE Main • Smart practice"
                    android:textColor="#60758A"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:text="2026"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/pill_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="YOUR NEXT STEP"
                android:textColor="#0B6EDE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Ready to crack your next test?"
                android:textColor="#102A43"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Practice PYQ-pattern questions, build accuracy and find weak topics."
                android:textColor="#60758A"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:gravity="center" android:background="@drawable/card_bg" android:layout_weight="1" android:padding="12dp" android:layout_marginEnd="5dp" android:layout_width="0dp" android:layout_height="84dp">
                <TextView android:text="📚" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Question Bank" android:textColor="#17324D" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:gravity="center" android:background="@drawable/card_bg" android:layout_weight="1" android:padding="12dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_width="0dp" android:layout_height="84dp">
                <TextView android:text="🎯" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Accuracy" android:textColor="#17324D" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:gravity="center" android:background="@drawable/card_bg" android:layout_weight="1" android:padding="12dp" android:layout_marginStart="5dp" android:layout_width="0dp" android:layout_height="84dp">
                <TextView android:text="🔥" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Streak" android:textColor="#17324D" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:text="Start Practice"
            android:textColor="#102A43"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/action"
            android:text="NEET Practice"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/primary_button"
            android:minHeight="54dp"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/secondary"
            android:text="JEE Main Practice"
            android:textColor="#0B6EDE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/secondary_button"
            android:minHeight="54dp"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginTop="18dp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="LIVE TEST"
                android:textColor="#60758A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/progress"
                android:text="Choose a practice test"
                android:textColor="#102A43"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/timer"
                android:text="Time left: 00:30:00"
                android:textColor="#D9485F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/question"
                android:text="Choose an exam to start practice"
                android:textColor="#102A43"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RadioGroup
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/result"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0A7A45"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/explanation"
                android:textSize="14sp"
                android:textColor="#52677B"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/filterInfo"
                android:text="All subjects • All types"
                android:textColor="#60758A"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>